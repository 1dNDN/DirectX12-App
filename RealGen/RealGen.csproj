<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<UseWindowsForms>true</UseWindowsForms>
		<RootNamespace>RealGen</RootNamespace>
		<TargetFramework>net8.0-windows</TargetFramework>
	</PropertyGroup>
	<ItemGroup>
	  <PackageReference Include="directxtk12_desktop_win10" Version="2025.10.28.1" />
	  <PackageReference Include="ObjParser" Version="0.1.0" />
	  <PackageReference Include="SharpDX" Version="4.0.1" />
	  <PackageReference Include="SharpDX.D3DCompiler" Version="4.0.1" />
	  <PackageReference Include="SharpDX.Direct3D12" Version="4.0.1" />
	  <PackageReference Include="SharpDX.DXGI" Version="4.0.1" />
	  <PackageReference Include="SharpDX.Mathematics" Version="4.0.1" />
	  <PackageReference Include="SharpGLTF.Core" Version="1.0.5" />
	</ItemGroup>
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
	  <Content Include="Shaders\**">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <None Remove="Models\**" />
	  <Content Include="Models\**">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>
  <ItemGroup>
    <Content Include="Shaders\Default.hlsl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Shaders\LightingUtil.hlsl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>