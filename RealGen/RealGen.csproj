<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<UseWindowsForms>true</UseWindowsForms>
		<RootNamespace>04-InitDirect3D</RootNamespace>
		<TargetFramework>net8.0-windows</TargetFramework>
	</PropertyGroup>
	<ItemGroup>
	  <PackageReference Include="ObjParser" Version="0.1.0" />
	  <PackageReference Include="SharpDX" Version="4.0.1" />
	  <PackageReference Include="SharpDX.D3DCompiler" Version="4.0.1" />
	  <PackageReference Include="SharpDX.Direct3D12" Version="4.0.1" />
	  <PackageReference Include="SharpDX.DXGI" Version="4.0.1" />
	  <PackageReference Include="SharpDX.Mathematics" Version="4.0.1" />
	</ItemGroup>
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
	  <Content Include="Shaders\pixel.hlsl">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Shaders\vertex.hlsl">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <None Remove="Models\jenjina.obj" />
	  <Content Include="Models\jenjina.obj">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <None Remove="Models\yoda.stl" />
	  <None Remove="Models\loubie_aria_dragon.stl" />
	  <Content Include="Models\loubie_aria_dragon.stl">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <None Remove="Models\dragon.stl" />
	  <Content Include="Models\dragon.stl">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>
</Project>